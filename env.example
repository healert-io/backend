# =============================================================================
# .env.example — Healert Backend Configuration
# =============================================================================
#
# Copyright 2026 Healert OÜ — Apache-2.0
#
# Copy to .env and fill in your values:
#   cp .env.example .env
#   chmod 600 .env
#
# Never commit .env to git — it contains your API key.
#
# =============================================================================

# =============================================================================
# REQUIRED
# =============================================================================

# API key — must match the HEALERT_API_KEY in the agent .env
# Generate: openssl rand -base64 32
# Or use:   ./healert.sh setup  (from agent directory)
HEALERT_API_KEY=

# =============================================================================
# OPTIONAL — DATABASE
# =============================================================================

# SQLite database file path
# Default: ./healert.db (in backend directory)
# HEALERT_DB=./healert.db

# =============================================================================
# OPTIONAL — SERVER
# =============================================================================

# Bind host — set to 0.0.0.0 to expose to network (use with HTTPS in production)
# Default: 127.0.0.1 (loopback only — not exposed to network)
# HEALERT_HOST=127.0.0.1

# Bind port
# Default: 8000
# HEALERT_PORT=8000

# =============================================================================
# OPTIONAL — CORS
# =============================================================================

# Allowed CORS origins — must include your Backstage URL
# Comma-separated for multiple origins
# Default: http://localhost:3000
# HEALERT_ALLOWED_ORIGINS=http://localhost:3000

# Production example (multiple origins):
# HEALERT_ALLOWED_ORIGINS=https://backstage.company.com,http://localhost:3000

# =============================================================================
# OPTIONAL — EVENT RETENTION
# =============================================================================

# How many days to keep events in the database
# Events older than this are deleted at startup and every 24 hours
# Default: 30
# HEALERT_RETENTION_DAYS=30

# =============================================================================
# OPTIONAL — SCORING PARAMETERS
# =============================================================================
# Configurable via: ./healert.sh configure scoring (from agent directory)

# Points needed for score=100 (critical)
# strict=20  balanced=50  lenient=100
# Default: 50
# SCORE_CRITICAL_THRESHOLD=50

# Event weight half-life in days
# fast=3  balanced=7  slow=14
# Default: 7
# SCORE_DECAY_HALF_LIFE=7

# Event window for scoring in days
# Default: 30
# SCORE_RETENTION_DAYS=30
